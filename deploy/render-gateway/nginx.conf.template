map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${PORT};
  server_name _;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = /api/health {
    add_header X-LoveConnect-Service auth always;
    proxy_pass http://${AUTH_SERVICE_HOSTPORT};
  }

  location ^~ /api/auth {
    add_header X-LoveConnect-Service auth always;
    proxy_pass http://${AUTH_SERVICE_HOSTPORT};
  }

  location ^~ /api/profiles {
    add_header X-LoveConnect-Service profile always;
    proxy_pass http://${PROFILE_SERVICE_HOSTPORT};
  }

  location ^~ /api/profile {
    add_header X-LoveConnect-Service profile always;
    proxy_pass http://${PROFILE_SERVICE_HOSTPORT};
  }

  location /api/search {
    add_header X-LoveConnect-Service profile always;
    proxy_pass http://${PROFILE_SERVICE_HOSTPORT};
  }

  location /api/likes {
    add_header X-LoveConnect-Service profile always;
    proxy_pass http://${PROFILE_SERVICE_HOSTPORT};
  }

  location /api/notifications {
    add_header X-LoveConnect-Service profile always;
    proxy_pass http://${PROFILE_SERVICE_HOSTPORT};
  }

  location /api/subscriptions {
    add_header X-LoveConnect-Service profile always;
    proxy_pass http://${PROFILE_SERVICE_HOSTPORT};
  }

  location /api/safety {
    add_header X-LoveConnect-Service profile always;
    proxy_pass http://${PROFILE_SERVICE_HOSTPORT};
  }

  location ^~ /api/chats {
    add_header X-LoveConnect-Service chat always;
    proxy_pass http://${CHAT_SERVICE_HOSTPORT};
  }

  location ^~ /api/chat {
    add_header X-LoveConnect-Service chat always;
    proxy_pass http://${CHAT_SERVICE_HOSTPORT};
  }

  location ^~ /api/calls {
    add_header X-LoveConnect-Service call always;
    proxy_pass http://${CALL_SERVICE_HOSTPORT};
  }

  location ^~ /ws {
    add_header X-LoveConnect-Service call always;
    proxy_pass http://${CALL_SERVICE_HOSTPORT};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  location / {
    return 404;
  }
}
