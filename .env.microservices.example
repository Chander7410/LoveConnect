# Copy this file to .env before running docker-compose.microservices.yml.

# Local Docker MongoDB is used by default. For Atlas, paste your Atlas URL here.
MONGODB_URI=mongodb://mongo:27017/loveconnect_mongo

# Use one strong secret across every microservice, otherwise login token will not verify between services.
APP_JWT_SECRET=change-this-to-a-long-random-production-secret
JWT_SECRET=change-this-to-a-long-random-production-secret
JWT_EXPIRY=86400

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180,http://localhost:8180,https://love-connect-beta.vercel.app
ALLOW_DEV_TOKENS=false
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email OTP / Brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_API_KEY=
MAIL_FROM=chandershekhar78458@gmail.com
SMTP_CONNECTION_TIMEOUT=10000
SMTP_TIMEOUT=10000
SMTP_WRITE_TIMEOUT=10000
APP_DEV_OTP_RESPONSE=false

# Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
